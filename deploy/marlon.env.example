# Server environment. Lives at /etc/marlon/marlon.env (root:marlon, 0640),
# read by systemd via EnvironmentFile.

# Nitro bind — loopback only; Caddy terminates TLS in front of it.
NITRO_HOST=127.0.0.1
NITRO_PORT=8081

# libsql: local SQLite file, or libsql://<db>.turso.io + auth token.
DATABASE_URL=file:/var/lib/marlon/marlon.db
#DATABASE_AUTH_TOKEN=

# Inngest Cloud credentials (required when INNGEST_DEV is unset).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional; categorization falls back to rules when unset.
OPENAI_API_KEY=
